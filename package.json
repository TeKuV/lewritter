{
  "name": "lewritter",
  "version": "0.1.0",
  "description": "Back-office Payload à la manière de WordPress : éditeur de blocs, médiathèque, connexion par une console OIDC.",
  "license": "MIT",
  "author": "TeKuV",
  "keywords": ["payload", "payload-plugin", "payloadcms", "cms", "wordpress", "wp-admin", "oidc", "back-office"],
  "repository": { "type": "git", "url": "git+https://github.com/TeKuV/lewritter.git" },
  "homepage": "https://github.com/TeKuV/lewritter#readme",
  "bugs": { "url": "https://github.com/TeKuV/lewritter/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./routes": { "types": "./dist/routes.d.ts", "default": "./dist/routes.js" },
    "./composants/*": { "types": "./dist/composants/*.d.ts", "default": "./dist/composants/*.js" },
    "./style.scss": "./dist/style.scss"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/style.scss','dist/style.scss')\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "jose": "^6.2.15"
  },
  "peerDependencies": {
    "@payloadcms/richtext-lexical": "^3.93.0",
    "@payloadcms/translations": "^3.93.0",
    "@payloadcms/ui": "^3.93.0",
    "next": ">=15",
    "payload": "^3.93.0",
    "react": "^19"
  },
  "devDependencies": {
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "next": "16.3.3",
    "payload": "3.93.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.7.3"
  }
}
